<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml" styleClass="auth-root"
      fx:controller="ni.edu.uam.administracionfx.controller.LoginController">

    <fx:include source="brand-panel.fxml"/>

    <StackPane HBox.hgrow="ALWAYS" styleClass="auth-side">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <VBox styleClass="card, auth-card" spacing="8" maxWidth="400" maxHeight="-Infinity">
            <Label text="Bienvenido de nuevo" styleClass="h1"/>
            <Label text="Inicia sesión para administrar los usuarios." styleClass="muted"/>

            <VBox spacing="6" styleClass="field-group">
                <Label text="Usuario o correo" styleClass="field-label"/>
                <TextField fx:id="txtLogin" promptText="jclopez o jc@uam.edu.ni"/>
            </VBox>

            <VBox spacing="6" styleClass="field-group">
                <Label text="Contraseña" styleClass="field-label"/>
                <StackPane>
                    <PasswordField fx:id="txtPassword" promptText="••••••••"/>
                    <TextField fx:id="txtPasswordVisible" promptText="••••••••" visible="false"/>
                </StackPane>
                <CheckBox fx:id="chkMostrar" text="Mostrar contraseña" styleClass="small"/>
            </VBox>

            <Label fx:id="lblError" styleClass="error-label" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>

            <StackPane styleClass="field-group">
                <Button fx:id="btnEntrar" text="Iniciar sesión" defaultButton="true"
                        maxWidth="Infinity" styleClass="btn-primary, btn-lg" onAction="#onEntrar"/>
                <ProgressIndicator fx:id="spinner" visible="false" maxWidth="22" maxHeight="22"
                                   styleClass="spinner"/>
            </StackPane>

            <HBox alignment="CENTER" spacing="4">
                <Label text="¿No tienes cuenta?" styleClass="muted"/>
                <Hyperlink text="Regístrate" onAction="#onIrARegistro" styleClass="link"/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
