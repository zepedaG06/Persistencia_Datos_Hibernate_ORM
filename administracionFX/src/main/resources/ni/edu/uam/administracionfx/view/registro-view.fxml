<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml" styleClass="auth-root"
      fx:controller="ni.edu.uam.administracionfx.controller.RegistroController">

    <fx:include source="brand-panel.fxml"/>

    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" fitToHeight="true" styleClass="auth-scroll">
        <StackPane styleClass="auth-side">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <VBox styleClass="card, auth-card" spacing="8" maxWidth="520" maxHeight="-Infinity">
                <Label text="Crea tu cuenta" styleClass="h1"/>
                <Label text="Completa tus datos. Los campos con * son obligatorios." styleClass="muted"/>

                <GridPane hgap="14" vgap="12" styleClass="field-group">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="Primer nombre *" styleClass="field-label"/>
                        <TextField fx:id="txtPrimerNombre" promptText="José"/>
                    </VBox>
                    <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label text="Segundo nombre" styleClass="field-label"/>
                        <TextField fx:id="txtSegundoNombre" promptText="Carlos"/>
                    </VBox>

                    <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label text="Primer apellido *" styleClass="field-label"/>
                        <TextField fx:id="txtPrimerApellido" promptText="López"/>
                    </VBox>
                    <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <Label text="Segundo apellido" styleClass="field-label"/>
                        <TextField fx:id="txtSegundoApellido" promptText="Martínez"/>
                    </VBox>

                    <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <Label text="Usuario *" styleClass="field-label"/>
                        <TextField fx:id="txtUsuario" promptText="jclopez"/>
                    </VBox>
                    <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <Label text="Correo *" styleClass="field-label"/>
                        <TextField fx:id="txtCorreo" promptText="jc@uam.edu.ni"/>
                    </VBox>

                    <VBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="0">
                        <Label text="Contraseña *" styleClass="field-label"/>
                        <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres"/>
                    </VBox>
                    <VBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <Label text="Confirmar contraseña *" styleClass="field-label"/>
                        <PasswordField fx:id="txtConfirmar" promptText="Repite la contraseña"/>
                    </VBox>
                </GridPane>

                <Label fx:id="lblFortaleza" styleClass="hint"/>

                <Label fx:id="lblError" styleClass="error-label" maxWidth="Infinity" wrapText="true"
                       visible="false" managed="false"/>

                <StackPane styleClass="field-group">
                    <Button fx:id="btnRegistrar" text="Crear cuenta" defaultButton="true"
                            maxWidth="Infinity" styleClass="btn-primary, btn-lg" onAction="#onRegistrar"/>
                    <ProgressIndicator fx:id="spinner" visible="false" maxWidth="22" maxHeight="22"
                                       styleClass="spinner"/>
                </StackPane>

                <HBox alignment="CENTER" spacing="4">
                    <Label text="¿Ya tienes cuenta?" styleClass="muted"/>
                    <Hyperlink text="Inicia sesión" onAction="#onIrALogin" styleClass="link"/>
                </HBox>
            </VBox>
        </StackPane>
    </ScrollPane>
</HBox>
